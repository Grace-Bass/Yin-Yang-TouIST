;; ===========================================================
;; = EXERCICE 1 — Codage de (R1) avec B(i,j) et N(i,j)
;; ===========================================================

$N ;; = 6

;; ===========================================================
;; = 1.1 Cellules pré-remplies (grille 1)
;; ===========================================================

B(2,3)
N(2,5)
B(2,6)

N(3,2)
B(3,3)
N(3,4)
B(3,5)

N(4,2)
B(4,6)

N(5,2)
N(5,3)

B(6,6)

;; ===========================================================
;; = 1.2 Chaque cellule contient exactement un pion
;; ===========================================================

bigand $i in 1..$N, $j in 1..$N:
    (B($i,$j) xor N($i,$j))

;; ===========================================================
;; = 1.3 Interdiction des carrés 2x2 monochromes
;; ===========================================================

bigand $i in 1..$N-1, $j in 1..$N-1:
(
    (B($i,$j) or B($i+1,$j) or B($i,$j+1) or B($i+1,$j+1))
    and
    (N($i,$j) or N($i+1,$j) or N($i,$j+1) or N($i+1,$j+1))
)