;; ===========================================================
;; = FICHIER : exercice2.touist
;; = Codage de (R1) avec uniquement des variables N(i,j)
;; ===========================================================

$N = 6

;; ===========================================================
;; = 2.1 Cellules pré-remplies (grille 1)
;; = N(i,j) ;; = vrai  <=>  pion noir
;; = N(i,j) ;; = faux  <=>  pion blanc
;; ===========================================================

N(2,5)
N(3,2)
N(3,4)
N(4,2)
N(5,2)
N(5,3)

not N(2,3)
not N(2,6)
not N(3,3)
not N(3,5)
not N(4,6)
not N(6,6)

;; ===========================================================
;; = 2.2 Interdiction des carrés 2x2 monochromes
;; ===========================================================

bigand $i, $j in [1, ($N-1)], [1, ($N-1)]:
    (
        ( N($i,$j) or N($i+1,$j) or N($i,$j+1) or N($i+1,$j+1) )
        and
        ( not N($i,$j) or not N($i+1,$j) or not N($i,$j+1) or not N($i+1,$j+1) )
    )