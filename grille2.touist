;; ===========================================================
;; = FICHIER : grille2.touist
;; = Grille n°2 (6x6) — R1 + R2 + R3
;; ===========================================================

$N = 6
$L = 12
$C = [B, N]

;; ===========================================================
;; = Cellules pré-remplies — Grille 2
;; ===========================================================

N(1,3)
B(1,5)

B(2,2)
N(2,4)
N(2,6)

N(3,1)
B(3,3)
B(3,4)
N(3,6)

B(4,2)
N(4,5)

N(5,3)
B(5,4)

B(6,1)
N(6,4)
B(6,6)

;; ===========================================================
;; = R1 — Chaque cellule contient exactement un pion
;; ===========================================================

bigand $i, $j in [1, ($N)],  [1, ($N)]:
    (B($i,$j) xor N($i,$j))
end

;; ===========================================================
;; = R1 — Interdiction des carrés 2x2 monochromes
;; ===========================================================

bigand $i, $j in [1, ($N-1)], [1, ($N-1)]:
(
    (B($i,$j) or B($i+1,$j) or B($i,$j+1) or B($i+1,$j+1))
    and
    (N($i,$j) or N($i+1,$j) or N($i,$j+1) or N($i+1,$j+1))
)
end

;; ===========================================================
;; = R2 & R3 — Construction des territoires
;; ===========================================================

;; = Étape 0 : une cellule de départ dans le carré 2x2
bigand $c in $C:
    (
        ( r(0,$c,1,1) or r(0,$c,1,2) or r(0,$c,2,1) or r(0,$c,2,2) )
        and
        ( not (r(0,$c,1,1) and r(0,$c,1,2)) )
        and
        ( not (r(0,$c,1,1) and r(0,$c,2,1)) )
        and
        ( not (r(0,$c,1,1) and r(0,$c,2,2)) )
        and
        ( not (r(0,$c,1,2) and r(0,$c,2,1)) )
        and
        ( not (r(0,$c,1,2) and r(0,$c,2,2)) )
        and
        ( not (r(0,$c,2,1) and r(0,$c,2,2)) )
    )
end

bigand $c, $i, $j in $C, [1, ($N)], [1, ($N)]:
    ( if ($i > 2) or ($j > 2) then not r(0,$c,$i,$j) else Top end )
end

;; = Persistance
bigand $c, $e, $i, $j in $C, [1, ($L)], [1, ($N)], [1, ($N)]:
    r($e-1,$c,$i,$j) => r($e,$c,$i,$j)
end

;; = Propagation par adjacence
bigand $c, $e, $i, $j in $C, [1, ($L)], [1, ($N)], [1, ($N)]:
    (r($e,$c,$i,$j) and not r($e-1,$c,$i,$j)) =>
    (
        (if ($i >= 2) then r($e-1,$c,$i-1,$j) else Bot end) or
        (if ($i < $N) then r($e-1,$c,$i+1,$j) else Bot end) or
        (if ($j >= 2) then r($e-1,$c,$i,$j-1) else Bot end) or
        (if ($j < $N) then r($e-1,$c,$i,$j+1) else Bot end)
    )
end

;; = Toutes les cellules de chaque couleur doivent être atteintes
bigand $i, $j in [1, ($N)], [1, ($N)]:
    (B($i,$j) => r($L,B,$i,$j))
    and
    (N($i,$j) => r($L,N,$i,$j))
end
